{
  "format_version": "1.21.0",
  "animation_controllers": {
    "controller.animation.mini_copper_golem.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "walk": "query.modified_move_speed > 0.1" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            { "idle": "query.modified_move_speed < 0.1" }
          ]
        }
      }
    }
  }
}
